-- =============================================
-- 20. PROCEDIMIENTOS ALMACENADOS
-- =============================================

DELIMITER //

CREATE PROCEDURE sp_actualizar_nivel_usuario(IN p_usuario_id INT)
BEGIN
    DECLARE v_xp INT;
    DECLARE v_nuevo_nivel INT;
    
    SELECT xp INTO v_xp FROM usuarios WHERE id = p_usuario_id;
    
    SELECT MAX(nivel) INTO v_nuevo_nivel 
    FROM niveles 
    WHERE xp_requerido <= v_xp;
    
    IF v_nuevo_nivel IS NOT NULL THEN
        UPDATE usuarios SET nivel = v_nuevo_nivel WHERE id = p_usuario_id;
    END IF;
END //

CREATE PROCEDURE sp_registrar_progreso_leccion(
    IN p_usuario_id INT,
    IN p_leccion_id INT,
    IN p_puntaje INT
)
BEGIN
    DECLARE v_xp_leccion INT;
    
    SELECT xp INTO v_xp_leccion FROM lecciones WHERE id = p_leccion_id;
    
    INSERT INTO progreso_lecciones (usuario_id, leccion_id, completada, puntaje, fecha_completada)
    VALUES (p_usuario_id, p_leccion_id, TRUE, p_puntaje, NOW())
    ON DUPLICATE KEY UPDATE
    completada = TRUE,
    puntaje = p_puntaje,
    fecha_completada = NOW(),
    intentos = intentos + 1;
    
    UPDATE usuarios SET xp = xp + v_xp_leccion WHERE id = p_usuario_id;
    CALL sp_actualizar_nivel_usuario(p_usuario_id);
END //

DELIMITER ;

-- =============================================
-- 21. VERIFICACIÓN FINAL
-- =============================================

SELECT '✅ Base de datos Politicore 2026 completada!' as Mensaje;
SELECT '📋 Tablas creadas:' as Info;
SHOW TABLES;

SELECT '👤 Usuarios creados:' as Info;
SELECT id, nombre, apellido_paterno, email, tipo_usuario_id, nivel, xp FROM usuarios;

SELECT '📚 Lecciones creadas:' as Info;
SELECT id, titulo, nivel, xp FROM lecciones;

SELECT '🎮 Simulaciones creadas:' as Info;
SELECT id, titulo, dificultad, activa FROM campanas_simulacion;

SELECT '📰 Noticias actualizadas:' as Info;
SELECT id, titulo, fecha FROM noticias;

SELECT '🏛️ Autoridades:' as Info;
SELECT id, nombre, apellido_paterno, cargo, partido FROM autoridades;

SELECT '📋 Tablas de tareas:' as Info;
SHOW TABLES LIKE 'tareas%';
SHOW TABLES LIKE 'entregas%';
SHOW TABLES LIKE 'descargas%';

SELECT '📋 Cartas de evento:' as Info;
SELECT id, titulo, icono, probabilidad, campana_id, escenas_validas FROM cartas_evento;

SELECT '📋 Rutas alternativas:' as Info;
SELECT ra.id, ce.titulo as carta, ra.escena_id, ra.siguiente_escena 
FROM rutas_alternativas ra
JOIN cartas_evento ce ON ra.carta_id = ce.id;

SELECT '📊 Distribución de cartas por simulación:' as Info;
SELECT 
    CASE 
        WHEN c.campana_id IS NULL THEN '🌍 General (todas)'
        ELSE CONCAT('📌 ', s.titulo)
    END as simulacion,
    COUNT(*) as total_cartas
FROM cartas_evento c
LEFT JOIN campanas_simulacion s ON c.campana_id = s.id
GROUP BY c.campana_id, s.titulo;

ALTER TABLE tareas ADD COLUMN archivo_nombre VARCHAR(255) NULL;

