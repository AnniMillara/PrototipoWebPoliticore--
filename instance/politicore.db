-- =============================================
-- BASE DE DATOS COMPLETA PARA POLITICORE 2026
-- VERSIÓN FINAL - CON SISTEMA DE CARTAS CONTEXTUALES
-- =============================================

-- 1. CREAR BASE DE DATOS
-- =============================================
DROP DATABASE IF EXISTS politicore;
CREATE DATABASE politicore CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE politicore;

-- =============================================
-- 2. TABLAS DE USUARIOS Y PERFILES
-- =============================================

-- 2.1 Tipos de Usuario
CREATE TABLE tipos_usuario (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE,
    descripcion TEXT,
    nivel_acceso INT DEFAULT 1,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_tipos_usuario_nombre (nombre)
);

-- 2.2 Usuarios
CREATE TABLE usuarios (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tipo_usuario_id INT NOT NULL DEFAULT 4,
    rut VARCHAR(12) UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    apellido_paterno VARCHAR(50) NOT NULL,
    apellido_materno VARCHAR(50),
    email VARCHAR(100) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    telefono VARCHAR(15),
    direccion TEXT,
    fecha_nacimiento DATE,
    genero ENUM('M', 'F', 'NB', 'Prefiero no decir') DEFAULT 'Prefiero no decir',
    avatar VARCHAR(255),
    nivel INT DEFAULT 1,
    xp INT DEFAULT 0,
    puntos INT DEFAULT 0,
    racha INT DEFAULT 0,
    ultimo_acceso TIMESTAMP NULL,
    activo BOOLEAN DEFAULT TRUE,
    email_verificado BOOLEAN DEFAULT FALSE,
    es_premium BOOLEAN DEFAULT FALSE,
    fecha_suscripcion DATE NULL,
    fecha_expiracion DATE NULL,
    plan VARCHAR(50) DEFAULT 'gratis',
    foto_perfil VARCHAR(255) NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (tipo_usuario_id) REFERENCES tipos_usuario(id) ON DELETE RESTRICT,
    INDEX idx_usuarios_email (email),
    INDEX idx_usuarios_rut (rut),
    INDEX idx_usuarios_nivel (nivel),
    INDEX idx_usuarios_activo (activo)
);

-- 2.3 Perfiles de Estudiante
CREATE TABLE perfiles_estudiante (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL UNIQUE,
    establecimiento VARCHAR(200),
    curso VARCHAR(20),
    anio_ingreso YEAR,
    nivel_educativo ENUM('Básica', 'Media', 'Superior', 'Otro') DEFAULT 'Media',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE
);

-- 2.4 Perfiles de Docente
CREATE TABLE perfiles_docente (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL UNIQUE,
    especialidad VARCHAR(200),
    anos_experiencia INT DEFAULT 0,
    establecimiento VARCHAR(200),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE
);

-- 2.5 Perfiles de Administrador
CREATE TABLE perfiles_admin (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL UNIQUE,
    rol_administrativo VARCHAR(100),
    permisos JSON,
    area VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE
);

-- =============================================
-- 3. TABLAS DE AUTORIDADES
-- =============================================

CREATE TABLE tipos_autoridad (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion TEXT,
    nivel_jerarquico INT DEFAULT 1,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE autoridades (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tipo_autoridad_id INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    apellido_paterno VARCHAR(50),
    apellido_materno VARCHAR(50),
    cargo VARCHAR(100) NOT NULL,
    foto VARCHAR(255),
    descripcion_cargo TEXT,
    biografia TEXT,
    partido VARCHAR(100),
    fecha_inicio DATE,
    fecha_fin DATE,
    activo BOOLEAN DEFAULT TRUE,
    prioridad INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (tipo_autoridad_id) REFERENCES tipos_autoridad(id) ON DELETE RESTRICT
);

CREATE TABLE funciones_autoridad (
    id INT AUTO_INCREMENT PRIMARY KEY,
    autoridad_id INT NOT NULL,
    descripcion TEXT NOT NULL,
    orden INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (autoridad_id) REFERENCES autoridades(id) ON DELETE CASCADE
);

-- =============================================
-- 4. TABLAS DE PROPUESTAS
-- =============================================

CREATE TABLE propuestas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    autoridad_id INT NOT NULL,
    titulo VARCHAR(200) NOT NULL,
    descripcion TEXT,
    explicacion TEXT,
    impacto_personal TEXT,
    fuente_oficial VARCHAR(255),
    fecha_publicacion DATE,
    estado ENUM('Borrador', 'Publicada', 'Archivada', 'En proceso', 'En tramitación', 'En preparación') DEFAULT 'Borrador',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (autoridad_id) REFERENCES autoridades(id) ON DELETE CASCADE
);

-- =============================================
-- 5. TABLAS DE LECCIONES Y APRENDIZAJE
-- =============================================

CREATE TABLE mundos_aprendizaje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    icono VARCHAR(50),
    descripcion TEXT,
    nivel_minimo INT DEFAULT 1,
    xp_requerido INT DEFAULT 0,
    orden INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE lecciones (
    id INT AUTO_INCREMENT PRIMARY KEY,
    mundo_id INT NOT NULL,
    titulo VARCHAR(200) NOT NULL,
    icono VARCHAR(50),
    situacion_inicial TEXT,
    explicacion TEXT,
    explicacion_porque TEXT,
    explicacion_quien TEXT,
    ejemplo TEXT,
    historia TEXT,
    curiosidad TEXT,
    reflexion TEXT,
    xp INT DEFAULT 50,
    nivel ENUM('Básico', 'Intermedio', 'Avanzado') DEFAULT 'Intermedio',
    duracion_estimada INT DEFAULT 10,
    orden INT DEFAULT 0,
    activo BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (mundo_id) REFERENCES mundos_aprendizaje(id) ON DELETE CASCADE
);

CREATE TABLE actividades_leccion (
    id INT AUTO_INCREMENT PRIMARY KEY,
    leccion_id INT NOT NULL,
    tipo ENUM('Alternativas', 'Ordenar', 'Relacionar', 'Arrastrar', 'Falso_Verdadero', 'Completar', 'Interpretar') DEFAULT 'Alternativas',
    pregunta TEXT NOT NULL,
    opciones JSON,
    respuesta_correcta JSON,
    explicacion TEXT,
    orden INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (leccion_id) REFERENCES lecciones(id) ON DELETE CASCADE
);

CREATE TABLE preguntas_cuestionario (
    id INT AUTO_INCREMENT PRIMARY KEY,
    leccion_id INT NOT NULL,
    pregunta TEXT NOT NULL,
    orden INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (leccion_id) REFERENCES lecciones(id) ON DELETE CASCADE
);

CREATE TABLE opciones_pregunta (
    id INT AUTO_INCREMENT PRIMARY KEY,
    pregunta_id INT NOT NULL,
    opcion TEXT NOT NULL,
    es_correcta BOOLEAN DEFAULT FALSE,
    orden INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (pregunta_id) REFERENCES preguntas_cuestionario(id) ON DELETE CASCADE
);

-- =============================================
-- 6. TABLAS DE PROGRESO Y LOGROS
-- =============================================

CREATE TABLE progreso_lecciones (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL,
    leccion_id INT NOT NULL,
    completada BOOLEAN DEFAULT FALSE,
    puntaje INT DEFAULT 0,
    intentos INT DEFAULT 0,
    tiempo_invertido INT DEFAULT 0,
    fecha_completada TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (leccion_id) REFERENCES lecciones(id) ON DELETE CASCADE,
    UNIQUE KEY unique_progreso (usuario_id, leccion_id)
);

CREATE TABLE insignias (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    icono VARCHAR(50),
    descripcion TEXT,
    xp_requerido INT DEFAULT 0,
    lecciones_requeridas INT DEFAULT 0,
    nivel_requerido INT DEFAULT 0,
    rareza ENUM('Común', 'Poco común', 'Rara', 'Épica', 'Legendaria') DEFAULT 'Común',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE insignias_obtenidas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL,
    insignia_id INT NOT NULL,
    fecha_obtenida TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (insignia_id) REFERENCES insignias(id) ON DELETE CASCADE,
    UNIQUE KEY unique_insignia_usuario (usuario_id, insignia_id)
);

CREATE TABLE niveles (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nivel INT NOT NULL UNIQUE,
    nombre VARCHAR(50) NOT NULL,
    xp_requerido INT NOT NULL,
    icono VARCHAR(50),
    descripcion TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- =============================================
-- 7. TABLAS DE SIMULACIONES
-- =============================================

CREATE TABLE campanas_simulacion (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(200) NOT NULL,
    descripcion TEXT,
    dificultad ENUM('Básico', 'Intermedio', 'Avanzado') DEFAULT 'Intermedio',
    introduccion JSON,
    escenas JSON,
    finales JSON,
    eventos JSON,
    duracion_estimada INT DEFAULT 15,
    xp_recompensa INT DEFAULT 100,
    activa BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE progreso_simulacion (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL,
    campana_id INT NOT NULL,
    escena_actual INT DEFAULT 1,
    indicadores JSON,
    decisiones JSON,
    historial JSON,
    completada BOOLEAN DEFAULT FALSE,
    puntaje_total INT DEFAULT 0,
    tiempo_total INT DEFAULT 0,
    fecha_inicio TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_completada TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (campana_id) REFERENCES campanas_simulacion(id) ON DELETE CASCADE,
    UNIQUE KEY unique_progreso_sim (usuario_id, campana_id)
);

-- =============================================
-- 8. TABLAS DE NOTICIAS Y CONTENIDO
-- =============================================

CREATE TABLE noticias (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(200) NOT NULL,
    descripcion TEXT,
    contenido TEXT,
    fecha DATE,
    icono VARCHAR(50),
    url VARCHAR(255),
    imagen VARCHAR(255),
    categoria VARCHAR(50),
    activa BOOLEAN DEFAULT TRUE,
    destacada BOOLEAN DEFAULT FALSE,
    fecha_publicacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE contenido_generado (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tipo ENUM('leccion', 'simulacion', 'historia') NOT NULL,
    titulo VARCHAR(200) NOT NULL,
    contenido JSON NOT NULL,
    creado_por INT NULL,
    creado_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    publicado BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (creado_por) REFERENCES usuarios(id) ON DELETE SET NULL,
    INDEX idx_contenido_tipo (tipo),
    INDEX idx_contenido_publicado (publicado)
);

-- =============================================
-- 9. TABLA DE ESTABLECIMIENTOS
-- =============================================

CREATE TABLE establecimientos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(200) NOT NULL,
    tipo ENUM('Municipal', 'Particular Subvencionado', 'Particular Pagado', 'Corporación') DEFAULT 'Municipal',
    direccion TEXT,
    comuna VARCHAR(100),
    region VARCHAR(100),
    telefono VARCHAR(15),
    email VARCHAR(100),
    niveles_educativos JSON,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- =============================================
-- 10. TABLAS DE TAREAS Y DESCARGAS
-- =============================================

-- 10.1 Tareas
CREATE TABLE tareas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(200) NOT NULL,
    descripcion TEXT NOT NULL,
    archivo_url VARCHAR(500),
    creado_por INT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (creado_por) REFERENCES usuarios(id) ON DELETE SET NULL
);

-- 10.2 Entregas de tareas
CREATE TABLE entregas_tareas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tarea_id INT NOT NULL,
    profesor_id INT NOT NULL,
    archivo_entregado VARCHAR(500),
    comentario_entrega TEXT,
    fecha_entrega TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    calificacion DECIMAL(5,2),
    comentario_calificacion TEXT,
    revisado_por INT,
    FOREIGN KEY (tarea_id) REFERENCES tareas(id) ON DELETE CASCADE,
    FOREIGN KEY (profesor_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (revisado_por) REFERENCES usuarios(id) ON DELETE SET NULL,
    UNIQUE KEY unique_entrega (tarea_id, profesor_id),
    INDEX idx_entregas_tarea (tarea_id)
);

-- 10.3 Descargas
CREATE TABLE descargas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(200) NOT NULL,
    descripcion TEXT,
    archivo_url VARCHAR(500),
    categoria VARCHAR(50),
    activo BOOLEAN DEFAULT TRUE,
    creado_por INT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (creado_por) REFERENCES usuarios(id) ON DELETE SET NULL,
    INDEX idx_descargas_activo (activo)
);

-- =============================================
-- 11. TABLAS DE SALAS DE CLASE
-- =============================================

CREATE TABLE salas_clase (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT,
    codigo_acceso VARCHAR(10) UNIQUE NOT NULL,
    profesor_id INT NOT NULL,
    creada_en DATETIME DEFAULT CURRENT_TIMESTAMP,
    activa BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (profesor_id) REFERENCES usuarios(id) ON DELETE CASCADE
);

CREATE TABLE sala_alumnos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sala_id INT NOT NULL,
    alumno_id INT NOT NULL,
    fecha_ingreso DATETIME DEFAULT CURRENT_TIMESTAMP,
    activo BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (sala_id) REFERENCES salas_clase(id) ON DELETE CASCADE,
    FOREIGN KEY (alumno_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    UNIQUE KEY unique_sala_alumno (sala_id, alumno_id)
);

CREATE TABLE sala_progreso (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sala_id INT NOT NULL,
    alumno_id INT NOT NULL,
    leccion_id INT NOT NULL,
    completada BOOLEAN DEFAULT FALSE,
    fecha_completada DATETIME NULL,
    puntaje INT DEFAULT 0,
    FOREIGN KEY (sala_id) REFERENCES salas_clase(id) ON DELETE CASCADE,
    FOREIGN KEY (alumno_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (leccion_id) REFERENCES lecciones(id) ON DELETE CASCADE,
    UNIQUE KEY unique_progreso (sala_id, alumno_id, leccion_id)
);

-- =============================================
-- 12. TABLAS DE CARTAS DE EVENTO Y RUTAS (CON CAMPOS CONTEXTUALES)
-- =============================================

-- 12.1 Cartas de Evento (con campos para contexto por simulación)
CREATE TABLE cartas_evento (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(200) NOT NULL,
    descripcion TEXT NOT NULL,
    icono VARCHAR(50) DEFAULT 'bolt',
    tipo VARCHAR(50) DEFAULT 'sorpresa',
    efectos JSON,
    mensaje_visible TEXT,
    probabilidad DECIMAL(3,2) DEFAULT 0.15,
    activa BOOLEAN DEFAULT TRUE,
    creado_por INT,
    creada_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    -- 👇 CAMPOS PARA CONTEXTUALIZAR LAS CARTAS
    campana_id INT NULL COMMENT 'ID de la simulación específica. NULL = aparece en todas',
    escenas_validas JSON NULL COMMENT 'Array de escenas donde puede aparecer. NULL = todas',
    contexto VARCHAR(50) DEFAULT 'general' COMMENT 'Contexto de la carta',
    FOREIGN KEY (creado_por) REFERENCES usuarios(id) ON DELETE SET NULL,
    FOREIGN KEY (campana_id) REFERENCES campanas_simulacion(id) ON DELETE CASCADE,
    INDEX idx_cartas_activa (activa),
    INDEX idx_cartas_campana (campana_id)
);

-- 12.2 Rutas Alternativas
CREATE TABLE rutas_alternativas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    carta_id INT NOT NULL,
    escena_id INT NOT NULL,
    nuevo_contexto TEXT NOT NULL,
    nuevo_problema TEXT NOT NULL,
    opciones JSON NOT NULL,
    siguiente_escena INT NOT NULL,
    creada_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (carta_id) REFERENCES cartas_evento(id) ON DELETE CASCADE,
    INDEX idx_rutas_carta (carta_id),
    INDEX idx_rutas_escena (escena_id)
);

-- =============================================
-- 13. VISTAS ÚTILES
-- =============================================

CREATE VIEW v_usuarios_completos AS
SELECT 
    u.id,
    u.nombre,
    u.apellido_paterno,
    u.email,
    u.nivel,
    u.xp,
    u.activo,
    tu.nombre as tipo_usuario,
    tu.nivel_acceso,
    pe.establecimiento,
    pe.curso,
    pe.nivel_educativo,
    pd.especialidad,
    pd.anos_experiencia,
    pa.rol_administrativo
FROM usuarios u
LEFT JOIN tipos_usuario tu ON u.tipo_usuario_id = tu.id
LEFT JOIN perfiles_estudiante pe ON u.id = pe.usuario_id
LEFT JOIN perfiles_docente pd ON u.id = pd.usuario_id
LEFT JOIN perfiles_admin pa ON u.id = pa.usuario_id;

CREATE VIEW v_progreso_usuarios AS
SELECT 
    u.id as usuario_id,
    u.nombre,
    u.apellido_paterno,
    u.nivel,
    u.xp,
    COUNT(DISTINCT pl.leccion_id) as lecciones_completadas,
    COUNT(DISTINCT io.insignia_id) as insignias_obtenidas,
    SUM(pl.puntaje) as puntaje_total
FROM usuarios u
LEFT JOIN progreso_lecciones pl ON u.id = pl.usuario_id AND pl.completada = TRUE
LEFT JOIN insignias_obtenidas io ON u.id = io.usuario_id
GROUP BY u.id, u.nombre, u.apellido_paterno, u.nivel, u.xp;

