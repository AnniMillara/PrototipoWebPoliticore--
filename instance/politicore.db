-- Placeholder table for view `politicore`.`v_progreso_usuarios`
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `politicore`.`v_progreso_usuarios` (`usuario_id` INT, `nombre` INT, `apellido_paterno` INT, `nivel` INT, `xp` INT, `lecciones_completadas` INT, `insignias_obtenidas` INT, `puntaje_total` INT);

-- -----------------------------------------------------
-- Placeholder table for view `politicore`.`v_usuarios_completos`
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `politicore`.`v_usuarios_completos` (`id` INT, `nombre` INT, `apellido_paterno` INT, `email` INT, `nivel` INT, `xp` INT, `activo` INT, `tipo_usuario` INT, `nivel_acceso` INT, `establecimiento` INT, `curso` INT, `nivel_educativo` INT, `especialidad` INT, `anos_experiencia` INT, `rol_administrativo` INT);

-- -----------------------------------------------------
-- procedure sp_actualizar_nivel_usuario
-- -----------------------------------------------------

DELIMITER $$
USE `politicore`$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_actualizar_nivel_usuario`(IN p_usuario_id INT)
BEGIN
    DECLARE v_xp INT;
    DECLARE v_nuevo_nivel INT;
    
    SELECT xp INTO v_xp FROM usuarios WHERE id = p_usuario_id;
    
    SELECT MAX(nivel) INTO v_nuevo_nivel 
    FROM niveles 
    WHERE xp_requerido <= v_xp;
    
    IF v_nuevo_nivel IS NOT NULL THEN
        UPDATE usuarios SET nivel = v_nuevo_nivel WHERE id = p_usuario_id;
    END IF;
END$$

DELIMITER ;

-- -----------------------------------------------------
-- procedure sp_registrar_progreso_leccion
-- -----------------------------------------------------

DELIMITER $$
USE `politicore`$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_registrar_progreso_leccion`(
    IN p_usuario_id INT,
    IN p_leccion_id INT,
    IN p_puntaje INT
)
BEGIN
    DECLARE v_xp_leccion INT;
    
    SELECT xp INTO v_xp_leccion FROM lecciones WHERE id = p_leccion_id;
    
    INSERT INTO progreso_lecciones (usuario_id, leccion_id, completada, puntaje, fecha_completada)
    VALUES (p_usuario_id, p_leccion_id, TRUE, p_puntaje, NOW())
    ON DUPLICATE KEY UPDATE
    completada = TRUE,
    puntaje = p_puntaje,
    fecha_completada = NOW(),
    intentos = intentos + 1;
    
    UPDATE usuarios SET xp = xp + v_xp_leccion WHERE id = p_usuario_id;
    CALL sp_actualizar_nivel_usuario(p_usuario_id);
END$$

DELIMITER ;

-- -----------------------------------------------------
-- View `politicore`.`v_progreso_usuarios`
-- -----------------------------------------------------
DROP TABLE IF EXISTS `politicore`.`v_progreso_usuarios`;
USE `politicore`;
CREATE  OR REPLACE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `politicore`.`v_progreso_usuarios` AS select `u`.`id` AS `usuario_id`,`u`.`nombre` AS `nombre`,`u`.`apellido_paterno` AS `apellido_paterno`,`u`.`nivel` AS `nivel`,`u`.`xp` AS `xp`,count(distinct `pl`.`leccion_id`) AS `lecciones_completadas`,count(distinct `io`.`insignia_id`) AS `insignias_obtenidas`,sum(`pl`.`puntaje`) AS `puntaje_total` from ((`politicore`.`usuarios` `u` left join `politicore`.`progreso_lecciones` `pl` on(((`u`.`id` = `pl`.`usuario_id`) and (`pl`.`completada` = true)))) left join `politicore`.`insignias_obtenidas` `io` on((`u`.`id` = `io`.`usuario_id`))) group by `u`.`id`,`u`.`nombre`,`u`.`apellido_paterno`,`u`.`nivel`,`u`.`xp`;

-- -----------------------------------------------------
-- View `politicore`.`v_usuarios_completos`
-- -----------------------------------------------------
DROP TABLE IF EXISTS `politicore`.`v_usuarios_completos`;
USE `politicore`;
CREATE  OR REPLACE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `politicore`.`v_usuarios_completos` AS select `u`.`id` AS `id`,`u`.`nombre` AS `nombre`,`u`.`apellido_paterno` AS `apellido_paterno`,`u`.`email` AS `email`,`u`.`nivel` AS `nivel`,`u`.`xp` AS `xp`,`u`.`activo` AS `activo`,`tu`.`nombre` AS `tipo_usuario`,`tu`.`nivel_acceso` AS `nivel_acceso`,`pe`.`establecimiento` AS `establecimiento`,`pe`.`curso` AS `curso`,`pe`.`nivel_educativo` AS `nivel_educativo`,`pd`.`especialidad` AS `especialidad`,`pd`.`anos_experiencia` AS `anos_experiencia`,`pa`.`rol_administrativo` AS `rol_administrativo` from ((((`politicore`.`usuarios` `u` left join `politicore`.`tipos_usuario` `tu` on((`u`.`tipo_usuario_id` = `tu`.`id`))) left join `politicore`.`perfiles_estudiante` `pe` on((`u`.`id` = `pe`.`usuario_id`))) left join `politicore`.`perfiles_docente` `pd` on((`u`.`id` = `pd`.`usuario_id`))) left join `politicore`.`perfiles_admin` `pa` on((`u`.`id` = `pa`.`usuario_id`)));

SET SQL_MODE=@OLD_SQL_MODE;
SET FOREIGN_KEY_CHECKS=@OLD_FOREIGN_KEY_CHECKS;
SET UNIQUE_CHECKS=@OLD_UNIQUE_CHECKS;